# ===== CareerLens 环境变量 =====
# 复制为 .env 后按需修改。所有服务共用此文件（Docker Compose 与本地运行）。

# --- LLM（OpenAI-compatible）---
# 留空则 AI 服务自动降级为规则算法（可跑通闭环）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- MySQL ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=careerlens
MYSQL_USER=root
MYSQL_PASSWORD=123456

# --- 服务端口 ---
AI_SERVICE_PORT=8001
BACKEND_PORT=8080
BFF_PORT=3000
FRONTEND_PORT=5173

# --- BFF ---
BACKEND_BASE_URL=http://localhost:8080
AI_TIMEOUT_MS=30000
